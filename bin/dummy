#!/usr/bin/env bash
set -euo pipefail

################################################################################
# bin/dummy — Start test/dummy integration app via process-compose
################################################################################
#
# USAGE
# -----
#   bin/dummy                         Start dummy app (TUI dashboard)
#   bin/dummy -D                      Start headless (for agents)
#   bin/dummy stop                    Stop dummy services
#   bin/dummy status                  Show service status
#   bin/dummy logs <service>          Show logs for a service
#   bin/dummy restart <service>       Restart a service
#
# Uses the root process-compose.yml with only dummy services enabled.
# Runs on a separate UDS socket so it won't conflict with bin/dev.
#
################################################################################

# Separate UDS socket for the dummy stack (appends -dummy to avoid bin/dev conflict)
pc_sock="${TMPDIR:-/tmp}process-compose-$(basename "$(pwd)")-dummy.sock"
pc_flags=(-U -u "$pc_sock")

case "${1:-}" in
  -D)        shift; process-compose up -D "${pc_flags[@]}" dummy dummy-css dummy-css-engine "$@" ;;
  stop)      process-compose "${pc_flags[@]}" down ;;
  status)
    fmt="--output wide"; [[ "${2:-}" == "--json" ]] && fmt="--output json"
    process-compose "${pc_flags[@]}" process list $fmt 2>/dev/null || { echo "Dummy app is not running. Start it with: bin/dummy"; exit 1; }
    ;;
  logs)      process-compose "${pc_flags[@]}" process logs "${2:?specify a service}" ;;
  restart)   process-compose "${pc_flags[@]}" process restart "${2:?specify a service}" ;;
  *)         process-compose up "${pc_flags[@]}" dummy dummy-css dummy-css-engine "$@" ;;
esac
