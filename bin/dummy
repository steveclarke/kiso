#!/usr/bin/env bash
set -euo pipefail

################################################################################
# bin/dummy — Start test/dummy app via Foreman
################################################################################
#
# USAGE
# -----
#   bin/dummy                           Start on port 5000 (foreground)
#   bin/dummy -m web=1,css=1            Start specific services
#   DUMMY_PORT=3001 bin/dummy           Start on a custom port
#
################################################################################

# Load .env if present (for outport-managed ports, etc.)
if [ -f .env ]; then
  set -a
  source .env
  set +a
fi

if ! gem list foreman -i --silent; then
  echo "Installing foreman..."
  gem install foreman
fi

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
DUMMY_DIR="${SCRIPT_DIR}/../test/dummy"

echo "Starting dummy app..."
echo "  Dummy app → http://localhost:${DUMMY_PORT:-5000}"
echo ""

cd "$DUMMY_DIR"
exec foreman start -f Procfile.dev "$@"
