#!/usr/bin/env bash
set -euo pipefail

################################################################################
# bin/dev — Start development services via Foreman
################################################################################
#
# USAGE
# -----
#   bin/dev                           Start all services (foreground)
#   bin/dev -m web=1,css=1,docs=0     Start specific services
#
# SERVICES (defined in Procfile.dev)
# ----------------------------------
#   web         Lookbook Rails server (port $LOOKBOOK_PORT, default 4001)
#   css         Tailwind CSS watcher
#   css-engine  Engine CSS change detector (requires entr)
#   docs        Bridgetown docs site (port $DOCS_PORT, default 4000)
#
################################################################################

# Load .env if present (for outport-managed ports, etc.)
if [ -f .env ]; then
  set -a
  source .env
  set +a
fi

if ! gem list foreman -i --silent; then
  echo "Installing foreman..."
  gem install foreman
fi

echo "Starting services..."
echo "  Lookbook → http://localhost:${LOOKBOOK_PORT:-4001}"
echo "  Docs     → http://localhost:${DOCS_PORT:-4000}"
echo ""

exec foreman start -f Procfile.dev "$@"
