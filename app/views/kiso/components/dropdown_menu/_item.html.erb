<%# locals: (variant: :default, inset: false, disabled: false,
             href: nil, method: nil, turbo: false, form: {},
             css_classes: "", **component_options) %>
<%# Clickable menu action. Polymorphic tag: <button> by default, <a> when href:
    is provided, form+button when href: + method: (non-GET). With turbo: true +
    method: renders an anchor with data-turbo-method (broadcast-safe). %>
<%
  css = Kiso::Themes::DropdownMenuItem.render(variant: variant, class: css_classes)
  data = kiso_prepare_options(component_options, slot: "dropdown-menu-item",
    kiso__dropdown_menu_target: "item",
    action: "click->kiso--dropdown-menu#selectItem",
    inset: (inset ? "" : nil),
    variant: (variant == :destructive ? "destructive" : nil),
    disabled: (disabled ? "true" : nil))
  component_options[:role] = "menuitem"
  component_options[:tabindex] = "-1"
  component_options[:aria] = { disabled: (disabled || nil) }
  use_button_to = href.present? && method.present? && method.to_s != "get" && !turbo
%>
<% if use_button_to %>
  <%
    form_attrs = { class: "contents w-full" }
    form_attrs.merge!(form) if form.present?
    form_attrs[:method] = "post"
    form_attrs[:action] = href
  %>
  <%= content_tag :form, **form_attrs do %>
    <% if method.to_s != "post" %>
      <%= tag :input, type: "hidden", name: "_method", value: method, autocomplete: "off" %>
    <% end %>
    <%= tag :input, type: "hidden", name: "authenticity_token", value: form_authenticity_token, autocomplete: "off" %>
    <%= content_tag :button, class: css, type: "submit", data: data,
        disabled: disabled || nil, **component_options do %>
      <%= yield %>
    <% end %>
  <% end %>
<% elsif href.present? %>
  <% component_options[:href] = href
     component_options[:"aria-disabled"] = true if disabled
     data[:turbo_method] = method if turbo && method.present? && method.to_s != "get" %>
  <%= content_tag :a, class: css, data: data, **component_options do %>
    <%= yield %>
  <% end %>
<% else %>
  <% component_options[:type] = :button
     component_options[:disabled] = true if disabled %>
  <%= content_tag :button, class: css, data: data, **component_options do %>
    <%= yield %>
  <% end %>
<% end %>
