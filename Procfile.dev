# Lookbook web server (Rails + Lookbook UI)
web: cd lookbook && RAILS_MAX_THREADS=10 bin/rails server -p ${LOOKBOOK_PORT:-4001}

# Tailwind CSS watcher — monitors @source directories and the input file
css: cd lookbook && bin/rails tailwindcss:watch

# Engine CSS change detector (requires: brew install entr)
#
# The Tailwind CLI watcher (css process) only monitors directories from @source
# directives. Engine CSS files in app/assets/tailwind/kiso/ are linked via
# @import — not @source — so changes to component CSS (tooltip.css, dialog.css,
# etc.) are invisible to the watcher. This is a Tailwind CLI limitation: it
# tracks @import dependencies for rebuild triggers (via onDependency), but the
# @parcel/watcher only subscribes to @source directories.
#
# This process uses entr(1) to watch the engine CSS directory and touch the
# Lookbook input file on change, which triggers the Tailwind watcher to rebuild.
# The -d flag makes entr exit when new files are added; the while loop restarts
# it to pick up the new file. See project/decisions/005-engine-css-watcher.md.
css-engine: while true; do find app/assets/tailwind/kiso -name "*.css" | entr -d -p touch lookbook/app/assets/tailwind/application.css; done

# Docs site (Bridgetown)
docs: cd docs && bin/bridgetown start -P ${DOCS_PORT:-4000}
